# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL (or local PostgreSQL) connection string.
# Written automatically to .env.local by `neon deploy` or configured in Vercel Environment Variables.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# AUTH_SECRET: Random 32+ char secret used to sign HttpOnly session cookies for /login and /admin.
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_STRING"

# ADMIN_EMAIL & ADMIN_PASSWORD: Optional bootstrap admin credentials.
# If omitted, the first-time setup screen on /login lets the owner email set a password once.
ADMIN_EMAIL="mahmoudnageeb2709@gmail.com"
ADMIN_PASSWORD=""

# APK_DOWNLOAD_URL: Default fallback download URL when not yet overridden in /admin.
APK_DOWNLOAD_URL="https://github.com/MahmoudNageeb/AL-NAGEEB/releases/latest/download/AL-NAGEEB-v2.7.apk"

# NEXT_PUBLIC_APP_VERSION: Default fallback version label when not yet overridden in /admin.
NEXT_PUBLIC_APP_VERSION="2.7"

# Optional VAPID keys for Web Push (auto-generated and stored in PostgreSQL if omitted).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

